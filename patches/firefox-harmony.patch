new file mode 100644
index 00000000000..49b2ab8fbe8
--- /dev/null
+++ b/gfx/2d/FreeTypeConfig.cpp
@@ -0,0 +1,22 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "FreeTypeConfig.h"
+
+#include "mozilla/Assertions.h"
+#include FT_LCD_FILTER_H
+#include <cstdlib>
+#include <cstring>
+
+extern "C" FT_Bool mozilla_FreeTypeLcdGeometryEnabled(void) {
+  const char* mode = std::getenv("FIREFOX_QD_MODE");
+  return mode && !std::strcmp(mode, "subpixel");
+}
+
+extern "C" void mozilla_ConfigureFreeType(FT_Library library) {
+  if (!mozilla_FreeTypeLcdGeometryEnabled()) {
+    return;
+  }
+  FT_Vector geometry[3] = {{-21, -11}, {0, 21}, {21, -11}};
+  MOZ_RELEASE_ASSERT(FT_Library_SetLcdGeometry(library, geometry) == FT_Err_Ok);
+}
