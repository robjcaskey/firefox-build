#!/usr/bin/env python3
"""Parallel launcher; private profile and per-process rendering controls."""
import argparse,os
from pathlib import Path
root=Path(__file__).resolve().parents[1]
p=argparse.ArgumentParser(add_help=False)
p.add_argument('--qd-mode',choices=['gray','subpixel'],default='subpixel')
p.add_argument('--qd-profile',type=Path)
p.add_argument('--qd-build',action='store_true',help='test the local build with a separate default profile')
p.add_argument('--help-qd',action='store_true')
a,args=p.parse_known_args()
if a.help_qd:
 p.print_help();raise SystemExit()
binary=root/'obj-qd/dist/bin/firefox' if a.qd_build else Path.home()/'.local/opt/firefox-qd/firefox'
if not binary.is_file():raise SystemExit('Firefox QD build is not ready yet.')
profile=a.qd_profile or Path.home()/'.mozilla/firefox-qd'/('harmony-test-'+a.qd_mode if a.qd_build else a.qd_mode)
profile.mkdir(parents=True,exist_ok=True)
prefs=profile/'user.js'
existing=prefs.read_text() if prefs.exists() else ''
start='// BEGIN FIREFOX QD MANAGED SETTINGS'
end='// END FIREFOX QD MANAGED SETTINGS'
if start in existing and end in existing:
    before,rest=existing.split(start,1);_,after=rest.split(end,1);existing=before+after
managed=start+'\n'+(root/'config'/f'user-{a.qd_mode}.js').read_text()+end+'\n'
prefs.write_text(existing.rstrip()+'\n'+managed)
env=dict(os.environ,FIREFOX_QD_MODE=a.qd_mode,FONTCONFIG_FILE=str(root/'config'/f'fonts-{a.qd_mode}.conf'),MOZ_ENABLE_WAYLAND='1',MOZ_APP_REMOTINGNAME='firefox-esr')
os.execve(binary,[str(binary),'-no-remote','-profile',str(profile),*args],env)
